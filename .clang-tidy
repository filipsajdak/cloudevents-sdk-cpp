---
# The check set is curated rather than wholesale. An earlier draft enabled
# cppcoreguidelines-*, portability-* and misc-* entire, which rejected this
# project's own stated rules: #pragma once, the CE_HAS_* gate macros, and the
# union that any std::expected-shaped type is built from. A lint that fails on
# the code it is meant to guard gets switched off, so it is narrowed here instead.
#
# Every disabled check below names why it is off. Anything not named is on, and
# WarningsAsErrors keeps it that way.
Checks: >
  bugprone-*,
  cert-*,
  cppcoreguidelines-*,
  misc-*,
  modernize-*,
  performance-*,
  portability-*,
  readability-*,
  -bugprone-easily-swappable-parameters,
  -cppcoreguidelines-macro-to-enum,
  -cppcoreguidelines-macro-usage,
  -cppcoreguidelines-pro-type-union-access,
  -misc-include-cleaner,
  -misc-non-private-member-variables-in-classes,
  -modernize-macro-to-enum,
  -modernize-use-trailing-return-type,
  -portability-avoid-pragma-once,
  -readability-identifier-length,
  -readability-redundant-member-init,
  performance-for-range-copy,
  performance-unnecessary-value-param,
  performance-unnecessary-copy-initialization,
  performance-move-const-arg,
  performance-no-automatic-move,
  performance-inefficient-string-concatenation,
  performance-string-view-conversions,
  modernize-pass-by-value,
  readability-redundant-string-cstr,
  bugprone-dangling-handle,
  bugprone-return-const-ref-from-parameter,
  custom-*

# Why each of the above is disabled:
#
#   portability-avoid-pragma-once
#     CLAUDE.md requires exactly one #pragma once per header. Include guards are
#     not an option the project leaves open.
#
#   cppcoreguidelines-macro-usage, *-macro-to-enum, modernize-macro-to-enum
#     CE_HAS_EXPECTED and CE_HAS_REFLECTION must be macros: they gate #include
#     directives and whether ^^ splice syntax is parsed, neither of which a
#     constexpr bool or an enum can do. ADR-0006 records the reasoning, and the
#     ce::detail::has_* mirrors exist so library code never reads the macros.
#
#   cppcoreguidelines-pro-type-union-access
#     The result<T> polyfill stores its value and error in a union, which is how
#     every std::expected implementation works. There is no variant to prefer
#     here; variant is what this type is a leaner replacement for.
#
#   misc-non-private-member-variables-in-classes
#     Fires on that same anonymous union despite it sitting in a private section.
#
#   readability-redundant-member-init
#     CLAUDE.md requires optional aggregate members to carry an explicit {} so
#     the designated-initializer shape stays uniform and gcc's
#     -Wmissing-field-initializers stays quiet. The redundancy is the point.
#
#   bugprone-easily-swappable-parameters
#     Fires on honest pairs like (string detail, string where). Renaming to
#     satisfy it would make the signatures worse.
#
#   misc-include-cleaner
#     Too noisy across a header-only library whose headers include each other.
#
# The copy checks after the exclusions are already on through the globs. They
# are named so the set that catches needless copies (D-TIDY-6) reads in one
# place, and so narrowing a glob cannot switch one off unnoticed. custom-* is
# the four query-based checks under CustomChecks below; clang-tidy runs them
# only when given --experimental-custom-checks, which cmake/tidy_gate.py passes.

WarningsAsErrors: '*'
HeaderFilterRegex: '(include/cloudevents|test)/.*'
FormatStyle: file

CheckOptions:
  - key: readability-identifier-naming.NamespaceCase
    value: lower_case
  - key: readability-identifier-naming.ClassCase
    value: lower_case
  - key: readability-identifier-naming.StructCase
    value: lower_case
  - key: readability-identifier-naming.FunctionCase
    value: lower_case
  - key: readability-identifier-naming.VariableCase
    value: lower_case
  - key: readability-identifier-naming.EnumCase
    value: lower_case
  - key: readability-identifier-naming.EnumConstantCase
    value: lower_case
  - key: readability-identifier-naming.PrivateMemberSuffix
    value: '_'
  - key: readability-identifier-naming.MacroDefinitionPrefix
    value: 'CE_'

# Query-based checks for the copies the built-in checks do not see (D-TIDY-6).
CustomChecks:
  - Name: scudoai-copy-string-ref-param
    Query: |
      let str qualType(hasCanonicalType(hasDeclaration(classTemplateSpecializationDecl(hasName("::std::basic_string")))))
      let use declRefExpr(to(parmVarDecl(equalsBoundNode("p"))))
      match functionDecl(isDefinition(), unless(isImplicit()), unless(cxxMethodDecl(anyOf(isOverride(), isVirtual()))),
        unless(isExpansionInSystemHeader()), unless(isInstantiated()), unless(isTemplateInstantiation()),
        forEachDescendant(parmVarDecl(unless(isInstantiated()), unless(hasAncestor(lambdaExpr())), unless(hasAncestor(cxxMethodDecl(anyOf(isOverride(), isVirtual())))), hasType(lValueReferenceType(pointee(qualType(isConstQualified(), str))))).bind("p")),
        unless(hasDescendant(cxxMemberCallExpr(callee(cxxMethodDecl(hasAnyName("c_str", "data"))), on(use)))),
        unless(hasDescendant(cxxOperatorCallExpr(hasOverloadedOperatorName("="), hasArgument(1, ignoringImplicit(use))))),
        unless(hasDescendant(callExpr(forEachArgumentWithParam(ignoringImplicit(use), parmVarDecl(hasType(lValueReferenceType(pointee(qualType(str))))))))),
        unless(hasDescendant(cxxConstructExpr(forEachArgumentWithParam(ignoringImplicit(use), parmVarDecl(hasType(lValueReferenceType(pointee(qualType(str))))))))))
    Diagnostic:
      - BindName: p
        Message: "const std::string& parameter only read: take std::string_view"
        Level: Warning
  - Name: scudoai-copy-string-substr
    Query: |
      let str qualType(hasCanonicalType(hasDeclaration(classTemplateSpecializationDecl(hasName("::std::basic_string")))))
      let sub cxxMemberCallExpr(callee(cxxMethodDecl(hasName("substr"), ofClass(hasName("::std::basic_string")))))
      match cxxMemberCallExpr(
        callee(cxxMethodDecl(hasName("substr"), ofClass(hasName("::std::basic_string")))),
        unless(isExpansionInSystemHeader()),
        unless(hasAncestor(returnStmt(hasReturnValue(ignoringImplicit(sub))))),
        unless(hasAncestor(varDecl(unless(hasType(autoType())), hasInitializer(ignoringImplicit(sub))))),
        unless(hasAncestor(cxxOperatorCallExpr(hasAnyOverloadedOperatorName("=", "+", "+=")))),
        unless(hasAncestor(callExpr(callee(functionDecl(hasAnyName("push_back", "emplace_back", "emplace", "insert", "append", "assign", "::std::stoi", "::std::stol", "::std::stoll", "::std::stoul", "::std::stoull", "::std::stod", "::std::stof")))))),
        unless(hasAncestor(initListExpr()))
      ).bind("c")
    Diagnostic:
      - BindName: c
        Message: "substr on std::string allocates a copy that is only read: view it"
        Level: Warning
  - Name: scudoai-copy-function-param
    Query: |
      let fn qualType(hasCanonicalType(hasDeclaration(classTemplateSpecializationDecl(hasName("::std::function")))))
      match functionDecl(isDefinition(), unless(cxxMethodDecl(anyOf(isOverride(), isVirtual()))), unless(isExpansionInSystemHeader()), unless(isInstantiated()), unless(isTemplateInstantiation()),
        forEachDescendant(parmVarDecl(unless(isInstantiated()), unless(hasAncestor(lambdaExpr())), unless(hasAncestor(cxxMethodDecl(anyOf(isOverride(), isVirtual())))), anyOf(hasType(references(qualType(isConstQualified(), fn))), hasType(fn))).bind("p")),
        unless(hasDescendant(callExpr(callee(functionDecl(hasName("::std::move"))), hasArgument(0, declRefExpr(to(parmVarDecl(equalsBoundNode("p")))))))))
    Diagnostic:
      - BindName: p
        Message: "std::function parameter only invoked: take a template/auto&& callable or function_ref"
        Level: Warning
  - Name: scudoai-copy-view-member
    Query: |
      match fieldDecl(unless(isExpansionInSystemHeader()), unless(isImplicit()), unless(isInstantiated()),
        hasType(qualType(hasCanonicalType(hasDeclaration(classTemplateSpecializationDecl(hasAnyName("::std::basic_string_view", "::std::span"))))))).bind("f")
    Diagnostic:
      - BindName: f
        Message: "view data member: its owner must outlive this object"
        Level: Warning
