@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

# CTRE is the one hard dependency: ce::core names it and nothing else
# (SWR-ADOPT-0002).
find_dependency(ctre)

include("${CMAKE_CURRENT_LIST_DIR}/cloudeventsTargets.cmake")

# The codecs this package was built with. Empty is legal and supported.
set(_ce_shipped_codecs "@CE_CODECS@")
set(_ce_known_codecs nlohmann rapidjson boost_json)
foreach(_ce_codec IN LISTS _ce_known_codecs)
  set(cloudevents_codec_${_ce_codec}_FOUND FALSE)
endforeach()

# No codec is a hard dependency, even when the SDK was built with one.
# find_dependency would make it one, and a consumer that wants only ce::core -
# which depends on CTRE alone - would then be unable to use the package at all.
#
# Each is looked up softly instead, and only its own component is reported
# missing. A consumer that needs one asks for it:
#
#   find_package(cloudevents REQUIRED COMPONENTS codec_nlohmann)
#
# and gets a failure naming the component rather than a failure of the package.
if("nlohmann" IN_LIST _ce_shipped_codecs)
  set(_ce_why_nlohmann "nlohmann_json 3.12.0 or newer")
  find_package(nlohmann_json 3.12.0 QUIET)
  if(nlohmann_json_FOUND AND TARGET ce::codec_nlohmann)
    # The exported target deliberately carries no link to its JSON library,
    # because install(EXPORT) cannot export a dependency this project does not
    # own. Re-attach it here, where the imported target has just appeared.
    set_property(TARGET ce::codec_nlohmann APPEND
      PROPERTY INTERFACE_LINK_LIBRARIES nlohmann_json::nlohmann_json)
    set(cloudevents_codec_nlohmann_FOUND TRUE)
  endif()
endif()

if("rapidjson" IN_LIST _ce_shipped_codecs)
  set(_ce_why_rapidjson "the RapidJSON headers (rapidjson/document.h)")
  # Found by header, not by find_package(RapidJSON): its config module reports
  # the include directory of the tree it was configured in, and defines no
  # imported target. The wrapper target is ours, so the name cannot collide
  # with one a consumer already made.
  find_path(CE_RAPIDJSON_INCLUDE_DIR rapidjson/document.h)
  if(CE_RAPIDJSON_INCLUDE_DIR AND TARGET ce::codec_rapidjson)
    if(NOT TARGET ce_dep::rapidjson)
      add_library(ce_dep::rapidjson INTERFACE IMPORTED)
      set_target_properties(ce_dep::rapidjson PROPERTIES
        INTERFACE_INCLUDE_DIRECTORIES "${CE_RAPIDJSON_INCLUDE_DIR}"
        INTERFACE_SYSTEM_INCLUDE_DIRECTORIES "${CE_RAPIDJSON_INCLUDE_DIR}")
    endif()
    set_property(TARGET ce::codec_rapidjson APPEND
      PROPERTY INTERFACE_LINK_LIBRARIES ce_dep::rapidjson)
    set(cloudevents_codec_rapidjson_FOUND TRUE)
  endif()
endif()

if("boost_json" IN_LIST _ce_shipped_codecs)
  set(_ce_why_boost_json "Boost @CE_BOOST_MINIMUM@ or newer with the compiled Boost.JSON library")
  find_package(Boost @CE_BOOST_MINIMUM@ QUIET COMPONENTS json)
  if(TARGET Boost::json AND TARGET ce::codec_boost_json)
    set_property(TARGET ce::codec_boost_json APPEND
      PROPERTY INTERFACE_LINK_LIBRARIES Boost::json)
    set(cloudevents_codec_boost_json_FOUND TRUE)
  endif()
endif()

# check_required_components reports WHICH component was missing but not why, and
# "install the library" is the whole of the answer here. The two failures read
# differently on purpose: a codec this package never built is not the same
# problem as a codec whose library is absent.
foreach(_ce_codec IN LISTS _ce_known_codecs)
  if(NOT cloudevents_codec_${_ce_codec}_FOUND
     AND "codec_${_ce_codec}" IN_LIST cloudevents_FIND_COMPONENTS)
    if(NOT "${_ce_codec}" IN_LIST _ce_shipped_codecs)
      set(cloudevents_NOT_FOUND_MESSAGE
          "the codec_${_ce_codec} component was not built into this cloudevents \
package, which shipped: ${_ce_shipped_codecs}. Rebuild with \
-DCE_CODECS=${_ce_codec}, or supply your own codec: ce::json::json_codec is a \
concept, not a class.")
    else()
      # The nested dereference is deliberate: one loop, one explanation per
      # codec. It looks like a typo and is not.
      set(cloudevents_NOT_FOUND_MESSAGE
          "the codec_${_ce_codec} component requires ${_ce_why_${_ce_codec}}, \
which was not found. Install it, or use cloudevents without that component and \
supply your own codec: ce::json::json_codec is a concept, not a class.")
    endif()
  endif()
endforeach()

check_required_components(cloudevents)
