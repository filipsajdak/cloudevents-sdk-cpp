@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

find_dependency(ctre)
if(@CE_DEFAULT_CODEC@)
  find_dependency(nlohmann_json 3.12.0)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/cloudeventsTargets.cmake")

# The exported ce::codec_nlohmann deliberately carries no link to nlohmann, because
# install(EXPORT) cannot export a dependency this project does not own. Re-attach it
# here, where find_dependency has just supplied the imported target.
if(@CE_DEFAULT_CODEC@ AND TARGET ce::codec_nlohmann AND TARGET nlohmann_json::nlohmann_json)
  set_property(TARGET ce::codec_nlohmann APPEND
    PROPERTY INTERFACE_LINK_LIBRARIES nlohmann_json::nlohmann_json)
endif()

check_required_components(cloudevents)
