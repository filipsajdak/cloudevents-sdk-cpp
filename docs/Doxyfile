# API reference for the public headers (SPEC section 7, M6).
#
# Only include/ is scanned. The tests, examples and fuzz targets are read as
# source, not as reference material, and putting them here would bury the API.

PROJECT_NAME           = "cloudevents-cpp"
PROJECT_BRIEF          = "CloudEvents v1.0.2 for C++20"
OUTPUT_DIRECTORY       = doxygen
INPUT                  = ../include
FILE_PATTERNS          = *.hpp *.cppm
RECURSIVE              = YES

# detail/ is private. Documenting it would advertise a surface the SDK does not
# promise to keep.
EXCLUDE_PATTERNS       = */detail/*

EXTRACT_ALL            = NO
EXTRACT_STATIC         = NO
HIDE_UNDOC_MEMBERS     = YES
HIDE_UNDOC_CLASSES     = YES

# SPEC section 10 requires a one-line brief on every public symbol, so an
# undocumented one is a defect rather than a gap to tolerate. WARN_AS_ERROR
# makes the docs job say so.
WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_ERROR      = YES
WARN_NO_PARAMDOC       = NO
WARN_AS_ERROR          = FAIL_ON_WARNINGS
QUIET                  = YES

GENERATE_HTML          = YES
GENERATE_LATEX         = NO
GENERATE_TREEVIEW      = YES
JAVADOC_AUTOBRIEF      = YES

# The headers are full of templates and concepts; without this the reference
# shows the machinery rather than the interface.
HIDE_SCOPE_NAMES       = NO
SORT_MEMBER_DOCS       = NO
MACRO_EXPANSION        = YES
EXPAND_ONLY_PREDEF     = YES
PREDEFINED             = "CE_HAS_REFLECTION=0" \
                         "CE_HAS_EXPECTED=1" \
                         "__cpp_lib_format=201907L"
