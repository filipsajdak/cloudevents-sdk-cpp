<?xml version="1.0" encoding="UTF-8"?>
<!-- Generates the Kafka record goldens the Java CloudEvents SDK produces, and
     verifies that the records this SDK produced decode there (SWR-SEC-0008).
     The same cloudevents version as interop/java, plus the Kafka module. No broker
     is involved: the module converts an event to and from an in-memory
     ProducerRecord and ConsumerRecord. -->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>io.cloudevents.interop</groupId>
  <artifactId>cloudevents-interop-kafka-java</artifactId>
  <version>1.0</version>
  <packaging>jar</packaging>

  <properties>
    <maven.compiler.source>17</maven.compiler.source>
    <maven.compiler.target>17</maven.compiler.target>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <cloudevents.version>2.5.0</cloudevents.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>io.cloudevents</groupId>
      <artifactId>cloudevents-core</artifactId>
      <version>${cloudevents.version}</version>
    </dependency>
    <dependency>
      <groupId>io.cloudevents</groupId>
      <artifactId>cloudevents-json-jackson</artifactId>
      <version>${cloudevents.version}</version>
    </dependency>
    <dependency>
      <groupId>io.cloudevents</groupId>
      <artifactId>cloudevents-kafka</artifactId>
      <version>${cloudevents.version}</version>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>3.1.0</version>
        <configuration>
          <mainClass>interop.KafkaInterop</mainClass>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
