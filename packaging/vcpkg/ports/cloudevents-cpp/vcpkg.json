{
  "name": "cloudevents-cpp",
  "version": "0.6.1",
  "description": "CloudEvents v1.0.2 SDK for C++20: header-only, exception-free, with JSON codecs as optional features.",
  "homepage": "https://github.com/filipsajdak/cloudevents-sdk-cpp",
  "license": "Apache-2.0",
  "dependencies": [
    {
      "name": "ctre",
      "version>=": "3.9.0"
    },
    {
      "name": "vcpkg-cmake",
      "host": true
    },
    {
      "name": "vcpkg-cmake-config",
      "host": true
    }
  ],
  "default-features": [
    "nlohmann"
  ],
  "features": {
    "boost-json": {
      "description": "Build the Boost.JSON codec (ce::codec_boost_json). It needs the compiled Boost.JSON library.",
      "dependencies": [
        "boost-json"
      ]
    },
    "nlohmann": {
      "description": "Build the nlohmann/json codec (ce::codec_nlohmann).",
      "dependencies": [
        {
          "name": "nlohmann-json",
          "version>=": "3.12.0"
        }
      ]
    },
    "rapidjson": {
      "description": "Build the RapidJSON codec (ce::codec_rapidjson).",
      "dependencies": [
        "rapidjson"
      ]
    }
  }
}
